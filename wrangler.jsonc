{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "darecade",
  "account_id": "2b1f3493e8bbdea98825e1c13bf04a66",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none",
  },
  "durable_objects": {
    "bindings": [
      { "name": "NEIGHBOURHOOD", "class_name": "Neighbourhood" },
      { "name": "WORLD", "class_name": "World" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Neighbourhood"] },
    { "tag": "v2", "new_sqlite_classes": ["World"] },
  ],
  "observability": { "enabled": false },
  "vars": {
    "LAUNCH_READY": "true",
    "PUBLIC_ORIGIN": "https://darecade.daniel-tianwen.workers.dev",
    "MAIL_FROM": "Darecade <hello@darecade.danielquek.com>",
    "PRIVACY_CONTACT": "hello@darecade.danielquek.com",
    "STORAGE_NOTICE": "Darecade stores your account and game data with Cloudflare. Southeast Asia placement is requested, but storage is not guaranteed to remain in Singapore. Sign-in email is delivered through Resend using its Tokyo sending region. Deleted data may remain in Cloudflare recovery history for up to 30 days.",
  },
}
