{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "darecade",
  "account_id": "2b1f3493e8bbdea98825e1c13bf04a66",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "playsimi.danielquek.com", "custom_domain": true }],
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none",
  },
  "durable_objects": {
    "bindings": [
      { "name": "NEIGHBOURHOOD", "class_name": "Neighbourhood" },
      { "name": "WORLD", "class_name": "World" },
      { "name": "RACE", "class_name": "Race" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Neighbourhood"] },
    { "tag": "v2", "new_sqlite_classes": ["World"] },
    { "tag": "v3", "new_sqlite_classes": ["Race"] },
  ],
  "observability": { "enabled": false },
  "vars": {
    "COMPETITION_SEASONS": "[]",
    "SEASON_VIEW": "false",
    "LAUNCH_READY": "true",
    "PAYMENTS_ENABLED": "true",
    "STRIPE_CATALOG": "{\"solar\":{\"priceId\":\"price_1UPMKVA6Maf1zlsl4GfE9AMj\",\"amount\":499},\"moon\":{\"priceId\":\"price_1UPMKWA6Maf1zlslrTAf5kdw\",\"amount\":499},\"storm\":{\"priceId\":\"price_1UPMKXA6Maf1zlslVglaeRCx\",\"amount\":499},\"sakura\":{\"priceId\":\"price_1UPMKXA6Maf1zlslGhHXbsXb\",\"amount\":499},\"nova\":{\"priceId\":\"price_1UPMKYA6Maf1zlsl8FRR9XAw\",\"amount\":499},\"abyss\":{\"priceId\":\"price_1UPMKZA6Maf1zlslCDQqx4bT\",\"amount\":499},\"tide\":{\"priceId\":\"price_1UPMKaA6Maf1zlslKtN5cggC\",\"amount\":499},\"phoenix\":{\"priceId\":\"price_1UPMKbA6Maf1zlsl5MCU99AL\",\"amount\":499},\"frost\":{\"priceId\":\"price_1UPMKbA6Maf1zlslgzMdg1Mx\",\"amount\":499},\"galaxy\":{\"priceId\":\"price_1UPMKcA6Maf1zlslLbr7nPO6\",\"amount\":499},\"donation-2\":{\"priceId\":\"price_1UMlawA6Maf1zlslqyOvyv9k\",\"amount\":200},\"donation-5\":{\"priceId\":\"price_1UMlbSA6Maf1zlsljHO1d4NZ\",\"amount\":500},\"donation-10\":{\"priceId\":\"price_1UMlbpA6Maf1zlsljWfHzGOD\",\"amount\":1000},\"donation-50\":{\"priceId\":\"price_1UMlcCA6Maf1zlslILMzs4ST\",\"amount\":5000},\"candy\":{\"priceId\":\"price_1UPMKdA6Maf1zlslAiV9f5oH\",\"amount\":499},\"boba\":{\"priceId\":\"price_1UPMKeA6Maf1zlslqUe1EInw\",\"amount\":499},\"pixel\":{\"priceId\":\"price_1UPMKeA6Maf1zlslTZTFEKLH\",\"amount\":499},\"witch\":{\"priceId\":\"price_1UPMKfA6Maf1zlslrDtsPOKQ\",\"amount\":499},\"garden\":{\"priceId\":\"price_1UPMKgA6Maf1zlslFhyT9eUW\",\"amount\":499},\"dino\":{\"priceId\":\"price_1UPMKhA6Maf1zlslOLW1fmeX\",\"amount\":499}}",
    "PUBLIC_ORIGIN": "https://playsimi.danielquek.com",
    "LEGACY_ORIGIN": "https://darecade.daniel-tianwen.workers.dev",
    "MAIL_FROM": "Play Simi <hello@playsimi.danielquek.com>",
    "PRIVACY_CONTACT": "hello@playsimi.danielquek.com",
    "STORAGE_NOTICE": "Play Simi stores your account and game data with Cloudflare. Southeast Asia placement is requested, but storage is not guaranteed to remain in Singapore. Sign-in email is delivered through Resend using its Tokyo sending region. Deleted data may remain in Cloudflare recovery history for up to 30 days.",
  },
}
