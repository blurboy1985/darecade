{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "darecade",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none",
  },
  "durable_objects": {
    "bindings": [{ "name": "NEIGHBOURHOOD", "class_name": "Neighbourhood" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Neighbourhood"] }],
  "observability": { "enabled": false },
  "vars": {
    "LAUNCH_READY": "false",
    "PUBLIC_ORIGIN": "",
    "MAIL_FROM": "",
    "PRIVACY_CONTACT": "",
    "STORAGE_NOTICE": "Darecade stores your account and game data with Cloudflare. Southeast Asia placement is requested, but storage is not guaranteed to remain in Singapore. Sign-in email is delivered through Resend. Deleted data may remain in Cloudflare recovery history for up to 30 days.",
  },
}
