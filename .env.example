# Copy to .env and run: node --env-file=.env server/index.mjs
# LOCAL DEVELOPMENT ONLY; no live email is sent by outbox mode.
PORT=4173
DARECADE_DATA=data
PUBLIC_ORIGIN=http://127.0.0.1:4173
MAIL_MODE=outbox
# Set LAN_HOST to this computer's Wi-Fi IPv4 address for phone testing.
# Set PUBLIC_ORIGIN to the same LAN URL so phone sign-in links work.
# LAN_HOST=192.168.1.109

# Public hosting requires all of these, plus reviewed Singapore hosting,
# TLS termination, backups/erasure procedures and provider privacy terms.
# NODE_ENV=production
# PUBLIC_ORIGIN=https://your-domain.example
# MAIL_MODE=resend
# RESEND_API_KEY=enter-locally-do-not-commit
# MAIL_FROM=Darecade <signin@your-verified-domain.example>
# PRIVACY_CONTACT=Your operator's monitored privacy email address
# STORAGE_NOTICE=Explain the actual database and email provider locations.
