# Copy to .env and run: node --env-file=.env server/index.mjs
# LOCAL DEVELOPMENT ONLY; no live email is sent by outbox mode.
PORT=4173
DARECADE_DATA=data
PUBLIC_ORIGIN=http://127.0.0.1:4173
MAIL_MODE=outbox
COMPETITION_SEASONS=[]
SEASON_VIEW=false
# Schedule only future Mondays at 00:00 +08:00. See SEASONS.md before enabling.
# Set LAN_HOST to this computer's Wi-Fi IPv4 address for phone testing.
# Set PUBLIC_ORIGIN to the same LAN URL so phone sign-in links work.
# LAN_HOST=<your-lan-ip>

# Public hosting requires all of these, plus reviewed Singapore hosting,
# TLS termination, backups/erasure procedures and provider privacy terms.
# NODE_ENV=production
# PUBLIC_ORIGIN=https://your-domain.example
# MAIL_MODE=resend
# RESEND_API_KEY=enter-locally-do-not-commit
# MAIL_FROM=Play Simi <signin@your-verified-domain.example>
# PRIVACY_CONTACT=Your operator's monitored privacy email address
# STORAGE_NOTICE=Explain the actual database and email provider locations.

# Optional one-time Stripe checkout. Disabled until you configure and test it.
PAYMENTS_ENABLED=false
STRIPE_CATALOG={}
# Enter secrets only in your local .env or Cloudflare secret bindings.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_CATALOG maps set IDs or donation-* IDs to {"priceId":"price_...","amount":<SGD cents>}.
# Use one-time SGD Prices. See PAYMENTS.md for sandbox/live setup and webhook events.
