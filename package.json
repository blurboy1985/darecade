{
  "name": "darecade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "node server/index.mjs",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.ts",
    "start": "node server/index.mjs",
    "cf:check": "npm run build && wrangler deploy --dry-run --outdir .browser/cloudflare-bundle",
    "cf:dev": "wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "test:cloudflare": "npm run cf:check && node --test tests/cloudflare.test.mjs",
    "load:test": "node scripts/load-test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.183.0",
    "miniflare": "5.20261001.0-alpha",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "8.3.2",
    "wrangler": "4.147.0",
    "ws": "^8.22.0"
  }
}
